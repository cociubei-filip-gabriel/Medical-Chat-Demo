<Page
    x:Class="ChatMEDICAL.Views.RequestAccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <Grid Background="#F0F4F8">

        <Border
            Width="550"
            Padding="35"
            CornerRadius="20"
            Background="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="#D0E1F9"
            BorderThickness="1">

            <StackPanel Spacing="16">

                <TextBlock
                    Text="Request Access"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#0078D7"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Complete your details to receive access to the medical system"
                    FontSize="14"
                    Foreground="#555555"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"/>

                <!-- Name Input -->
                <Border Background="#F9FBFC" CornerRadius="10" Padding="12,8" BorderBrush="#D0E1F9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Full Name" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox x:Name="FullNameBox" PlaceholderText="Enter your full name" BorderThickness="0" Background="Transparent" Padding="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CNP Input -->
                <Border Background="#F9FBFC" CornerRadius="10" Padding="12,8" BorderBrush="#D0E1F9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CNP" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox x:Name="CnpBox" PlaceholderText="Enter your CNP" BorderThickness="0" Background="Transparent" Padding="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Email Input -->
                <Border Background="#F9FBFC" CornerRadius="10" Padding="12,8" BorderBrush="#D0E1F9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Email Address" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox x:Name="EmailBox" PlaceholderText="Enter your email" BorderThickness="0" Background="Transparent" Padding="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Phone Input -->
                <Border Background="#F9FBFC" CornerRadius="10" Padding="12,8" BorderBrush="#D0E1F9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Phone Number" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox x:Name="PhoneBox" PlaceholderText="Enter your phone number" BorderThickness="0" Background="Transparent" Padding="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Specialty Input -->
                <Border Background="#F9FBFC" CornerRadius="10" Padding="12,8" BorderBrush="#D0E1F9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Preferred Specialty" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox x:Name="PreferredSpecialtyBox" PlaceholderText="e.g. Cardiology" BorderThickness="0" Background="Transparent" Padding="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Password Input -->
                <Border Background="#F9FBFC" CornerRadius="10" Padding="12,8" BorderBrush="#D0E1F9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Create Password" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        <PasswordBox x:Name="PasswordBox" PlaceholderText="Enter your password" BorderThickness="0" Background="Transparent" Padding="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Confirm Password Input -->
                <Border Background="#F9FBFC" CornerRadius="10" Padding="12,8" BorderBrush="#D0E1F9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Confirm Password" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" PlaceholderText="Confirm your password" BorderThickness="0" Background="Transparent" Padding="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Button
                    Content="Submit Request"
                    Height="48"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Background="#0078D7"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SubmitRequest_Click"/>

                <Button
                    Content="Back to Login"
                    Height="42"
                    Background="#FFFFFF"
                    Foreground="#0078D7"
                    BorderBrush="#D0E1F9"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    Click="Back_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
