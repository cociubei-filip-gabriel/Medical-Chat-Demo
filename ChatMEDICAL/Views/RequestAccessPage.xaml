<Page
    x:Class="ChatMEDICAL.Views.RequestAccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4FAFF">

        <Border
            Width="550"
            Padding="35"
            CornerRadius="20"
            Background="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="#DCEEFF"
            BorderThickness="2">

            <StackPanel Spacing="18">

                <TextBlock
                    Text="Register Patient"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#123B5D"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Complete your details to create a patient account"
                    FontSize="14"
                    Foreground="Gray"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"/>

                <TextBox x:Name="FullNameBox" Header="Full Name"/>
                <TextBox x:Name="CnpBox" Header="CNP"/>
                <TextBox x:Name="EmailBox" Header="Email"/>
                <TextBox x:Name="PhoneBox" Header="Phone Number"/>
                <TextBox x:Name="PreferredSpecialtyBox" Header="Preferred Specialty"/>

                <PasswordBox
                    x:Name="PasswordBox"
                    Header="Create Password"
                    PlaceholderText="Enter your password"/>

                <PasswordBox
                    x:Name="ConfirmPasswordBox"
                    Header="Confirm Password"
                    PlaceholderText="Confirm your password"/>

                <Button
                    Content="Register Patient"
                    Height="50"
                    Background="#BFE9FF"
                    Foreground="#123B5D"
                    FontWeight="Bold"
                    Click="SubmitRequest_Click"/>

                <Button
                    Content="Back to Login"
                    Height="42"
                    Background="#FFFFFF"
                    Foreground="#123B5D"
                    BorderBrush="#DCEEFF"
                    BorderThickness="1"
                    Click="Back_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>
