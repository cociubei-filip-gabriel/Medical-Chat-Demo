<Page
    x:Class="ChatMEDICAL.Views.AppointmentHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4FAFF">

        <StackPanel Padding="30" Spacing="20">

            <Button
                Content="← Back"
                Width="100"
                Height="40"
                Click="Back_Click"/>

            <TextBlock
                Text="Appointment History"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#123B5D"/>

            <TextBlock
                x:Name="StatusText"
                FontSize="15"
                Foreground="#333333"/>

            <Border
                Background="White"
                CornerRadius="18"
                Padding="20"
                BorderBrush="#DCEEFF"
                BorderThickness="2">

                <StackPanel Spacing="10">
                    <Grid Padding="10" Background="#E6F2FF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Doctor" FontWeight="Bold" Foreground="#123B5D"/>
                        <TextBlock Grid.Column="1" Text="Specialty" FontWeight="Bold" Foreground="#123B5D"/>
                        <TextBlock Grid.Column="2" Text="Date" FontWeight="Bold" Foreground="#123B5D"/>
                        <TextBlock Grid.Column="3" Text="Time" FontWeight="Bold" Foreground="#123B5D"/>
                        <TextBlock Grid.Column="4" Text="Status" FontWeight="Bold" Foreground="#123B5D"/>
                    </Grid>

                    <ListView x:Name="HistoryListView" MinHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding DoctorName}" TextWrapping="Wrap" Foreground="#333333"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Specialty}" TextWrapping="Wrap" Foreground="#333333"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Date}" Foreground="#333333"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Time}" Foreground="#333333"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Status}" FontWeight="Bold" Foreground="#333333"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>
</Page>
