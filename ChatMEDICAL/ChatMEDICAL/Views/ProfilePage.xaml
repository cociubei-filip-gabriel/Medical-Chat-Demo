<Page
    x:Class="ChatMEDICAL.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4FAFF">

        <ScrollViewer>
            <StackPanel Padding="30" Spacing="20">

                <!-- Title -->
                <TextBlock
                    Text="My Profile"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#123B5D"/>

                <!-- Profile Card -->
                <Border
                    Background="White"
                    CornerRadius="18"
                    Padding="25"
                    BorderBrush="#DCEEFF"
                    BorderThickness="2">

                    <StackPanel Spacing="14">

                        <TextBlock
                            Text="Personal Information"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#123B5D"/>

                        <TextBlock
                            x:Name="FullNameText"
                            Text="Full Name"
                            FontSize="16"/>

                        <TextBlock
                            x:Name="EmailText"
                            Text="Email"
                            FontSize="16"/>

                        <TextBlock
                            x:Name="PhoneText"
                            Text="Phone Number"
                            FontSize="16"/>

                        <TextBlock
                            x:Name="CnpText"
                            Text="CNP"
                            FontSize="16"/>

                        <TextBlock
                            x:Name="PreferredSpecialtyText"
                            Text="Preferred Specialty"
                            FontSize="16"/>

                    </StackPanel>

                </Border>

                <!-- Back Button -->
                <Button
                    Content="← Back"
                    Width="140"
                    Height="50"
                    Background="#BFE9FF"
                    Foreground="#123B5D"
                    FontWeight="Bold"
                    Click="Back_Click"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>