<Page
    x:Class="ChatMEDICAL.Views.AppointmentHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4FAFF">

        <StackPanel Padding="30" Spacing="20">

            <Button
                Content="← Back"
                Width="100"
                Height="40"
                Click="Back_Click"/>

            <TextBlock
                Text="Appointment History"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#123B5D"/>

            <Border
                Background="White"
                CornerRadius="18"
                Padding="20"
                BorderBrush="#DCEEFF"
                BorderThickness="2">

                <StackPanel Spacing="10">

                    <TextBlock
                        Text="Your appointment history will appear here."
                        FontSize="16"
                        Foreground="Gray"/>

                    <TextBlock
                        Text="(Backend/database will be connected by your teammate)"
                        FontSize="14"
                        Foreground="DarkGray"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>
</Page>