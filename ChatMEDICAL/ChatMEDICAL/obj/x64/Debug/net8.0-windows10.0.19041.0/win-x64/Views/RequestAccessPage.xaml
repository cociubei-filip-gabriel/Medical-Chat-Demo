<Page
    x:Class="ChatMEDICAL.Views.RequestAccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4FAFF">

        <Border
            Width="550"
            Padding="35"
            CornerRadius="20"
            Background="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="#DCEEFF"
            BorderThickness="2">

            <StackPanel Spacing="18">

                <TextBlock
                    Text="Request Access"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#123B5D"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Complete your details to receive access to the medical system"
                    FontSize="14"
                    Foreground="Gray"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"/>

                <TextBox Header="Full Name"/>
                <TextBox Header="CNP"/>
                <TextBox Header="Email"/>
                <TextBox Header="Phone Number"/>
                <TextBox Header="Preferred Specialty"/>

                <PasswordBox
    Header="Create Password"
    PlaceholderText="Enter your password"/>

                <PasswordBox
    Header="Confirm Password"
    PlaceholderText="Confirm your password"/>

                <Button x:ConnectionId='2'
    Content="Submit Request"
    Height="50"
    Background="#BFE9FF"
    Foreground="#123B5D"
    FontWeight="Bold"
                               />

                

            </StackPanel>

        </Border>

    </Grid>
</Page>

