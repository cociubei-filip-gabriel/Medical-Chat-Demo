<Page
    x:Class="ChatMEDICAL.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- Background Image -->
        <Image
            Source="ms-appx:///Assets/medical_bg.jpg"
            Stretch="UniformToFill"
            Opacity="0.95"/>

        <!-- Dark Overlay -->
        <Grid Background="#55000000"/>

        <!-- Login Card -->
        <Border
            Width="620"
            Padding="40"
            CornerRadius="25"
            Background="#F8FFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Spacing="22">

                <!-- Icon + Title on same line -->
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12">

                    <TextBlock
                        Text="🩺"
                        FontSize="34"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="Medical Chat"
                        FontSize="38"
                        FontWeight="Bold"
                        Foreground="Black"
                        VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Subtitle -->
                <TextBlock
                    Text=" Hello friend! Welcome back. Please login to continue."
                    FontSize="15"
                    Foreground="#666666"
                    HorizontalAlignment="Center"
                    Margin="0,-8,0,10"/>

                <!-- Medical ID -->
                <Border
                    Background="White"
                    CornerRadius="14"
                    Padding="12"
                    BorderBrush="#D9EFFF"
                    BorderThickness="2">

                    <StackPanel>
                        <TextBlock
                            Text="Email address"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#444"/>

                        <TextBox x:ConnectionId='5'
                            x:Name="EmailBox"
                            PlaceholderText="Enter your email"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="15"/>
                    </StackPanel>
                </Border>

                <!-- Password -->
                <Border
                    Background="White"
                    CornerRadius="14"
                    Padding="12"
                    BorderBrush="#D9EFFF"
                    BorderThickness="2">

                    <StackPanel>
                        <TextBlock
                            Text="Password"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#444"/>

                        <PasswordBox x:ConnectionId='4'
                            x:Name="PasswordBox"
                            PlaceholderText="Enter your password"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="15"/>
                    </StackPanel>
                </Border>

                <!-- Remember Me -->
                <CheckBox
                    Content="Remember Me"
                    FontSize="14"
                    Foreground="#444"
                    Margin="5,0,0,0"/>

                <!-- Buttons -->
                <StackPanel
    Orientation="Horizontal"
    HorizontalAlignment="Center"
    Spacing="20"
    Margin="0,10,0,0">

                    <!-- Login Button -->
                    <Button x:ConnectionId='2'
        Content="Login"
        Width="220"
        Height="52"
        Background="#0078D7"
        Foreground="White"
        FontWeight="Bold"
        FontSize="15"
                           />

                    <!-- Request Access Button -->
                    <Button x:ConnectionId='3'
        Content="Request Access"
        Width="220"
        Height="52"
        Background="#0078D7"
        Foreground="White"
        FontWeight="Bold"
        FontSize="15"
                                   />

                </StackPanel>

                <!-- Forgot Password -->
                <TextBlock
                    Text="Forgot Password?"
                    FontSize="14"
                    Foreground="#2D89EF"
                    HorizontalAlignment="Center"/>

                <!-- Footer -->
                <TextBlock
                    Text="© 2026 Medical Chat System"
                    FontSize="12"
                    Foreground="#888888"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>

