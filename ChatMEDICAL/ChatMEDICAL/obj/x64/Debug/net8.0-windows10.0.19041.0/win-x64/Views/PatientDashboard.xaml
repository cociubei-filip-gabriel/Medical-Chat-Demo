<Page
    x:Class="ChatMEDICAL.Views.PatientDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#0078D7"
            Padding="32,26">
            <StackPanel VerticalAlignment="Center" Spacing="10">
                <Button x:ConnectionId='14'
                    Content="Back"
                    Width="96"
                    Height="36"
                    HorizontalAlignment="Left"
                    Background="#005A9E"
                    Foreground="White"
                    FontWeight="Bold"
                                      />

                <TextBlock
                    Text="Welcome, Patient"
                    FontSize="34"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Text="Choose your specialty, doctor and schedule your appointment easily"
                    FontSize="16"
                    Foreground="#E0E0E0"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28" Spacing="18">

                <Border
                    Background="#FFFFFF"
                    CornerRadius="10"
                    Padding="22"
                    BorderBrush="#D0E1F9"
                    BorderThickness="1">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="Medical Specialty"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#333333"/>

                            <ComboBox x:ConnectionId='12'
                                x:Name="SpecialtyComboBox"
                                Width="420"
                                Height="44"
                                HorizontalAlignment="Left"
                                RequestedTheme="Light"
                                Background="#F9FBFC"
                                Foreground="#333333"
                                BorderBrush="#D0E1F9"
                                BorderThickness="1"
                                PlaceholderText="Select Specialty"
                                                                                     >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#333333"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock
                                Text="Doctor"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#333333"/>

                            <ComboBox x:ConnectionId='10'
                                x:Name="DoctorComboBox"
                                Width="420"
                                Height="44"
                                HorizontalAlignment="Left"
                                RequestedTheme="Light"
                                Background="#F9FBFC"
                                Foreground="#333333"
                                BorderBrush="#D0E1F9"
                                BorderThickness="1"
                                PlaceholderText="Select Doctor"/>

                            <TextBlock x:ConnectionId='11'
                                x:Name="DoctorStatusText"
                                Text=""
                                FontSize="13"
                                Foreground="#555555"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Background="#FFFFFF"
                    CornerRadius="10"
                    Padding="22"
                    BorderBrush="#D0E1F9"
                    BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock
                            Text="Request Appointment"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#333333"/>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                Width="420"
                                Height="44"
                                HorizontalAlignment="Left"
                                RequestedTheme="Light"
                                Background="#F9FBFC"
                                Foreground="#333333"
                                BorderBrush="#D0E1F9"
                                BorderThickness="1"
                                PlaceholderText="Choose Chief Nurse">
                                <ComboBoxItem Content="Sef asistente Elena Popa - Cardiology"/>
                                <ComboBoxItem Content="Sef asistente Mihaela Radu - Dermatology"/>
                                <ComboBoxItem Content="Sef asistente Cristina Luca - Orthopedics"/>
                                <ComboBoxItem Content="Sef asistente Adriana Pavel - Neurology"/>
                                <ComboBoxItem Content="Sef asistente Florina Iancu - Pediatrics"/>
                                <ComboBoxItem Content="Sef asistente Ramona Tudor - Gynecology"/>
                                <ComboBoxItem Content="Sef asistente Silvia Matei - Ophthalmology"/>
                                <ComboBoxItem Content="Sef asistente Gabriela Dinu - ENT"/>
                                <ComboBoxItem Content="Sef asistente Monica Rusu - Urology"/>
                                <ComboBoxItem Content="Sef asistente Claudia Pavel - Gastroenterology"/>
                            </ComboBox>

                            <DatePicker x:ConnectionId='7'
                                x:Name="AppointmentDatePicker"
                                Grid.Column="1"
                                Width="220"
                                RequestedTheme="Light"
                                Header="Appointment Date"
                                Foreground="#333333"/>

                            <TimePicker x:ConnectionId='8'
                                x:Name="AppointmentTimePicker"
                                Grid.Column="2"
                                Width="180"
                                RequestedTheme="Light"
                                Header="Time"
                                Foreground="#333333"/>

                            <Button x:ConnectionId='9'
                                Grid.Column="3"
                                Content="Book Appointment"
                                Height="44"
                                MinWidth="170"
                                Margin="0,24,0,0"
                                Background="#0078D7"
                                Foreground="White"
                                FontWeight="Bold"
                                                             />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Background="#E6F2FF"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#D0E1F9"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Chat Access"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#333333"/>

                        <TextBlock
                            Text="After your appointment is confirmed, your private doctor chat will be activated here."
                            FontSize="15"
                            Foreground="#555555"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border
                    Background="#FFFFFF"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#D0E1F9"
                    BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Text="Quick Access"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#333333"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:ConnectionId='2'
                                Content="My Profile"
                                Height="44"
                                Width="160"
                                Background="#0078D7"
                                Foreground="White"
                                FontWeight="Bold"
                                                     />

                            <Button x:ConnectionId='3'
                                Content="My Prescriptions"
                                Height="44"
                                Width="170"
                                Background="#0078D7"
                                Foreground="White"
                                FontWeight="Bold"
                                                          />

                            <Button x:ConnectionId='4'
                                Content="Appointment History"
                                Height="44"
                                Width="185"
                                Background="#0078D7"
                                Foreground="White"
                                FontWeight="Bold"
                                                     />

                            <Button x:ConnectionId='5'
                                Content="Upload Medical Files"
                                Height="44"
                                Width="190"
                                Background="#0078D7"
                                Foreground="White"
                                FontWeight="Bold"
                                                         />

                            <Button x:ConnectionId='6'
                                Content="Open Chat"
                                Height="44"
                                Width="150"
                                Background="#0078D7"
                                Foreground="White"
                                FontWeight="Bold"
                                                      />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

