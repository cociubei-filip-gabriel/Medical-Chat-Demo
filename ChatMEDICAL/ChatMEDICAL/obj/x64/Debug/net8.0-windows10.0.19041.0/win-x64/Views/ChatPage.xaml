<!-- ============================== -->
<!-- ChatPage.xaml (PATIENT SIDE) -->
<!-- ============================== -->

<Page
    x:Class="ChatMEDICAL.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4FAFF">

        <Grid.RowDefinitions>
            <!-- header mai mare ca sa nu fie trunchiat -->
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            Background="#DFF4FF"
            Padding="25">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- iconita mai aproape -->
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button x:ConnectionId='5'
                    Content="← Back"
                    Width="100"
                    Height="40"
                    Background="#BFE9FF"
                    Foreground="#123B5D"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                                      />

                <!-- Doctor Info -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">

                    <!-- nume doctor -->
                    <TextBlock x:ConnectionId='6'
                        x:Name="DoctorNameText"
                        Text="Assigned Doctor"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#123B5D"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"/>

                    <!-- status online -->
                    <Border
                        Background="#E8FFF0"
                        CornerRadius="12"
                        Padding="14,5"
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="🟢 Online • Specialist Available"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#0F8A43"
                            HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>

                <!-- Medical Icon -->
                <TextBlock
                    Grid.Column="2"
                    Text="🩺"
                    FontSize="26"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- CHAT AREA -->
        <ScrollViewer Grid.Row="1">

            <StackPanel x:ConnectionId='4'
                x:Name="MessagesPanel"
                Padding="30"
                Spacing="18">

            </StackPanel>

        </ScrollViewer>

        <!-- MESSAGE INPUT -->
        <Border
            Grid.Row="2"
            Background="White"
            Padding="20"
            BorderBrush="#DCEEFF"
            BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Message Box -->
                <TextBox x:ConnectionId='2'
                    x:Name="MessageBox"
                    PlaceholderText="Type your message here..."
                    Height="50"
                    FontSize="15"
                    VerticalAlignment="Center"/>

                <!-- Send Button -->
                <Button x:ConnectionId='3'
                    Grid.Column="1"
                    Content="Send"
                    Width="120"
                    Height="50"
                    Margin="15,0,0,0"
                    Background="#BFE9FF"
                    Foreground="#123B5D"
                    FontWeight="Bold"
                                      />

            </Grid>
        </Border>

    </Grid>
</Page>

