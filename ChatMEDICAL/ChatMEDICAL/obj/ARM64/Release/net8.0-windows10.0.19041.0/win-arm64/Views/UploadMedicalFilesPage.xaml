<Page
    x:Class="ChatMEDICAL.Views.UploadMedicalFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4FAFF">

        <StackPanel Padding="30" Spacing="20">

            <Button x:ConnectionId='2'
                Content="← Back"
                Width="100"
                Height="40"
                                  />

            <TextBlock
                Text="Upload Medical Files"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#123B5D"/>

            <Border
                Background="White"
                CornerRadius="18"
                Padding="20"
                BorderBrush="#DCEEFF"
                BorderThickness="2">

                <StackPanel Spacing="15">

                    <TextBlock
                        Text="Upload prescriptions, analysis, MRI, CT, X-Ray or other medical files."
                        FontSize="16"
                        TextWrapping="Wrap"/>

                    <Button
                        Content="Upload File"
                        Height="50"
                        Background="#BFE9FF"
                        Foreground="#123B5D"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="(Backend file upload will be connected later)"
                        FontSize="14"
                        Foreground="Gray"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>
</Page>

