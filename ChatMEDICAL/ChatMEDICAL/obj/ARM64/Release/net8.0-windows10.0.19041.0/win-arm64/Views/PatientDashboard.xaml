<Page
    x:Class="ChatMEDICAL.Views.PatientDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

	<Grid Background="#F3F9FD">

		<Grid.RowDefinitions>
			<RowDefinition Height="210"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<Border
            Grid.Row="0"
            Background="White"
            CornerRadius="0,0,30,30"
            Padding="45,40">

			<StackPanel>

				<Button
                    Content="← Back"
                    Width="110"
                    Height="42"
                    HorizontalAlignment="Left"
                    Background="#D9EEF9"
                    Foreground="#184C73"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    CornerRadius="10"/>

				<TextBlock
                    Text="Welcome, Patient 👋"
                    FontSize="42"
                    FontWeight="Bold"
                    Foreground="#0F172A"
                    Margin="0,30,0,10"/>

				<TextBlock
                    Text="Choose your specialty, doctor and schedule your appointment easily"
                    FontSize="17"
                    Foreground="#64748B"/>

			</StackPanel>

		</Border>

		<!-- CONTENT -->
		<ScrollViewer Grid.Row="1">

			<StackPanel
                Padding="35"
                Spacing="25">

				<!-- SPECIALTY + DOCTOR -->
				<Border
                    Background="White"
                    CornerRadius="24"
                    Padding="30">

					<Grid ColumnSpacing="50">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- SPECIALTY -->
						<StackPanel Spacing="15">

							<TextBlock
                                Text="Medical Specialty"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#0F172A"/>

							<ComboBox
                                Height="58"
                                PlaceholderText="Select Specialty"
                                Background="#F8FCFF"
                                BorderBrush="#C7E6F7"
                                BorderThickness="2"
                                CornerRadius="14">

								<ComboBoxItem Content="Cardiology"/>
								<ComboBoxItem Content="Dermatology"/>
								<ComboBoxItem Content="Orthopedics"/>
								<ComboBoxItem Content="Neurology"/>
								<ComboBoxItem Content="Pediatrics"/>

							</ComboBox>

						</StackPanel>

						<!-- DOCTOR -->
						<StackPanel
                            Grid.Column="1"
                            Spacing="15">

							<TextBlock
                                Text="Doctor"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#0F172A"/>

							<ComboBox
                                Height="58"
                                PlaceholderText="Select Doctor"
                                Background="#F8FCFF"
                                BorderBrush="#C7E6F7"
                                BorderThickness="2"
                                CornerRadius="14">

								<ComboBoxItem Content="Dr. Andrei Popescu"/>
								<ComboBoxItem Content="Dr. Maria Ionescu"/>
								<ComboBoxItem Content="Dr. Elena Dumitrescu"/>

							</ComboBox>

							<TextBlock
                                Text="3 doctors loaded."
                                FontSize="14"
                                Foreground="#94A3B8"/>

						</StackPanel>

					</Grid>

				</Border>

				<!-- APPOINTMENT -->
				<Border
                    Background="White"
                    CornerRadius="24"
                    Padding="30">

					<StackPanel Spacing="22">

						<TextBlock
                            Text="Request Appointment"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#0F172A"/>

						<Grid ColumnSpacing="25">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="1.3*"/>
								<ColumnDefinition Width="1.2*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<!-- NURSE -->
							<ComboBox
                                Grid.Column="0"
                                Height="58"
                                PlaceholderText="Choose Chief Nurse"
                                Background="#F8FCFF"
                                BorderBrush="#C7E6F7"
                                BorderThickness="2"
                                CornerRadius="14"/>

							<!-- DATE -->
							<DatePicker
                                Grid.Column="1"
                                Header="Appointment Date"/>

							<!-- TIME -->
							<TimePicker
                                Grid.Column="2"
                                Header="Time"/>

							<!-- BUTTON -->
							<Button
                                Grid.Column="3"
                                Content="Book Appointment"
                                Width="190"
                                Height="58"
                                Margin="0,22,0,0"
                                Background="#A9D3EA"
                                Foreground="#184C73"
                                FontWeight="Bold"
                                BorderThickness="0"
                                CornerRadius="14"/>

						</Grid>

					</StackPanel>

				</Border>

				<!-- CHAT -->
				<Border
                    Background="White"
                    CornerRadius="24"
                    Padding="30">

					<StackPanel Spacing="12">

						<TextBlock
                            Text="Chat Access"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#0F172A"/>

						<TextBlock
                            Text="After your appointment is confirmed, your private doctor chat will be activated here."
                            FontSize="16"
                            Foreground="#64748B"
                            TextWrapping="Wrap"/>

					</StackPanel>

				</Border>

				<!-- QUICK ACCESS -->
				<Border
                    Background="White"
                    CornerRadius="24"
                    Padding="30">

					<StackPanel Spacing="22">

						<TextBlock
                            Text="Quick Access"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#0F172A"/>

						<WrapPanel ItemHeight="55" ItemWidth="190">

							<Button
                                Content="My Profile"
                                Height="55"
                                Margin="0,0,15,15"
                                Background="#D9EEF9"
                                Foreground="#184C73"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                CornerRadius="14"/>

							<Button
                                Content="My Prescriptions"
                                Height="55"
                                Margin="0,0,15,15"
                                Background="#D9EEF9"
                                Foreground="#184C73"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                CornerRadius="14"/>

							<Button
                                Content="Appointment History"
                                Height="55"
                                Margin="0,0,15,15"
                                Background="#D9EEF9"
                                Foreground="#184C73"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                CornerRadius="14"/>

							<Button
                                Content="Upload Medical Files"
                                Height="55"
                                Margin="0,0,15,15"
                                Background="#D9EEF9"
                                Foreground="#184C73"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                CornerRadius="14"/>

							<Button
                                Content="Open Chat"
                                Height="55"
                                Margin="0,0,15,15"
                                Background="#D9EEF9"
                                Foreground="#184C73"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                CornerRadius="14"/>

						</WrapPanel>

					</StackPanel>

				</Border>

			</StackPanel>

		</ScrollViewer>

	</Grid>

</Page>